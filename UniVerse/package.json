{
  "name": "universe-root",
  "version": "1.0.0",
  "private": true,
  "description": "UniVerse - Full-stack college campus web application",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm --prefix client run build",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:demo": "npm --prefix server run seed:demo",
    "test:server": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
