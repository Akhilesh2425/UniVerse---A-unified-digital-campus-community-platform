# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/universe?retryWrites=true&w=majority
MONGO_URI=

# JWT Secret for Session Authentication (minimum 32 characters recommended)
JWT_SECRET=

# Frontend Client URL for CORS and Cookie Origin Matching
CLIENT_URL=http://localhost:5173

# Initial Administrator Credentials (used only by seed:admin script)
ADMIN_EMAIL=admin@universe.edu
ADMIN_PASSWORD=AdminSecure2026!
